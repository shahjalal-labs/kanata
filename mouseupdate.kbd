;; =========================================================
;; Kanata PRODUCTION config
;; =========================================================

(defcfg
  ;; "yes" lets tap-hold-press resolve instantly on ANY second
  ;; keypress, not just keys listed in defsrc.
  process-unmapped-keys yes
)

;; -----------------------------------------------------------------
;; defsrc: every physical key kanata will watch/remap
;; -----------------------------------------------------------------
(defsrc
  a    s    d    f    l    spc  lsft f3   ;    n    ret  .    caps h    j    k    u    p    m    rsft lctl i    o    ,    8    2    4    6    e    w
)

;; -----------------------------------------------------------------
;; defalias: reusable named actions
;; -----------------------------------------------------------------
(defalias
  ;; ---- Home row / dual-purpose mods ----
  a-th    (tap-hold-press 200 200 a    lctl)
  s-th    (tap-hold-press 200 200 s    lmet)
  d-th    (tap-hold-press 200 200 d    lsft)
  f-th    (tap-hold-press 200 200 f    lalt)
  l-th    (tap-hold-press 200 200 l    lsft)
  spc-th  (tap-hold-press 200 200 spc  lalt)
  n-th    (tap-hold-press 200 200 ret  lmet)

  lsft-th (tap-hold-press 200 200 f4   lsft)
  rsft-th (tap-hold-press 200 200 bspc rsft)
  semi-th (tap-hold-press 200 200 f3   lctl)
  lctl-th (tap-hold-press 200 200 f8   lctl)

  ;; ---- Capslock ----
  capsmod (multi lctl (layer-while-held capsnav))
  caps-th (tap-hold-press 200 200 esc @capsmod)

  ;; ---- Capslock nav-layer overrides ----
  nav-left    (unmod left)
  nav-down    (unmod down)
  nav-up      (unmod up)
  nav-right   (unmod rght)
  nav-f12     (unmod f12)
  nav-space   (unmod spc)
  nav-colon   (multi (release-key lctl) S-;)  ;; Shift+; = :
  nav-dollar  (multi (release-key lctl) S-4)  ;; Shift+4 = $
  nav-at      (multi (release-key lctl) S-2)  ;; Shift+2 = @
  nav-pastesp S-v                             ;; combined with held Ctrl = Ctrl+Shift+V

  ;; ===================================================================
  ;; MOUSE MODE
  ;; Double-tap "," to TOGGLE the mouse layer on/off. Single tap still
  ;; types a normal comma. layer-toggle means it STAYS ON until you
  ;; double-tap "," again (unlike capslock, which is hold-only).
  ;; ===================================================================
  mouse-toggle (layer-switch mouse)
  comma-td    (tap-dance 350 (, @mouse-toggle))
  ;; While already inside mouse mode, a single tap of "," exits straight
  ;; back to base -- no double-tap needed to leave.
  mouse-exit  (layer-switch base)

  ;; Cursor movement: accelerates the longer you hold (starts slow,
  ;; speeds up). Params: (interval-ms, ramp-up-ms, min-speed, max-speed).
  ;; Tune these numbers later if it feels too slow/fast for you.
  ms-cursor-up    (movemouse-accel-up    10 500 2 40)
  ms-cursor-down  (movemouse-accel-down  10 500 2 40)
  ms-cursor-left  (movemouse-accel-left  10 500 2 40)
  ms-cursor-right (movemouse-accel-right 10 500 2 40)

  ;; Scrolling: continuous while held. Params: (interval-ms, distance).
  ;; 120 distance = one notch of a physical wheel.
  ms-scroll-up    (mwheel-up    20 120)
  ms-scroll-down  (mwheel-down  20 120)
  ms-scroll-left  (mwheel-left  20 120)
  ms-scroll-right (mwheel-right 20 120)

  ;; Clicking: tap = instant click+release. Hold = button stays down
  ;; (needed for drag-select / drag-and-drop).
  ms-left  (tap-hold-press 200 200 mltp mlft)
  ms-right (tap-hold-press 200 200 mrtp mrgt)
  ms-mid   (tap-hold-press 200 200 mmtp mmid)
)

;; -----------------------------------------------------------------
;; deflayer: base layer (always active unless caps or mouse-mode is on)
;; Order matches defsrc exactly:
;; a s d f l spc lsft f3 ; n ret . caps h j k u p m rsft lctl i o , 8 2 4 6 e w
;; -----------------------------------------------------------------
(deflayer base
  @a-th @s-th @d-th @f-th @l-th @spc-th @lsft-th ; @semi-th @n-th . n @caps-th h j k u p m @rsft-th @lctl-th i o @comma-td 8 2 4 6 e w
)

;; -----------------------------------------------------------------
;; deflayer: capsnav (active only while capslock is held)
;; -----------------------------------------------------------------
(deflayer capsnav
  _ _ _ _ @nav-right _ _ _ @nav-pastesp _ _ _ _ @nav-left @nav-down @nav-up @nav-colon @nav-f12 @nav-space _ _ @nav-dollar @nav-at _ _ _ _ _ _ _
)

;; -----------------------------------------------------------------
;; deflayer: mouse (toggled on/off by double-tapping ",")
;; Everything not listed below is transparent (_), falling through
;; to base layer, so normal typing still works while mouse-mode is on.
;; -----------------------------------------------------------------
(deflayer mouse
  ;; defsrc order:
  ;; a  s  d  f  l  spc lsft f3 ;  n  ret .  caps h  j  k  u  p  m  rsft lctl i  o  ,  8  2  4  6  e  w
  _  @ms-mid @ms-right @ms-left @ms-cursor-right _ _ _ _ _ _ _ _
  @ms-cursor-left @ms-cursor-down @ms-cursor-up
  @ms-scroll-up @ms-scroll-right _ _ _
  @ms-scroll-down @ms-scroll-left @mouse-exit
  _ _ _ _ pgup pgdn
)
